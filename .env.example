# ── Copy this file to .env and fill in your values ──────────────────

# LLM — Add your OpenAI key to enable AI-synthesized answers.
# Without it, the app runs in "context-only" mode (retrieves chunks, no GPT synthesis).
OPENAI_API_KEY=sk-...

# Model to use (gpt-3.5-turbo is fast & cheap; gpt-4o for best quality)
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Embedding model (local, free — no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5

# ChromaDB collection name
CHROMA_COLLECTION=file_intelligence

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
