# ── Copy this file to .env and fill in your values ───────────────────
# v2: Mistral + LangChain + FAISS

# ─────────────────────────────────────────────────────────────────────
# MISTRAL API (Primary LLM — recommended)
# Get your key at: https://console.mistral.ai/
# ─────────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest
# Other options: mistral-small-latest, open-mistral-7b, open-mixtral-8x7b

# ─────────────────────────────────────────────────────────────────────
# OPENAI API (Legacy fallback — optional)
# Only used if MISTRAL_API_KEY is not set.
# ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-3.5-turbo

# ─────────────────────────────────────────────────────────────────────
# GEMINI API (Optional external provider — Google's cloud API, distinct
# from Gemma, which runs locally via Ollama and needs no key here)
# Get your key at: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────────────────────────────
# LLM Generation Settings (shared by Mistral, OpenAI, and Gemini)
# ─────────────────────────────────────────────────────────────────────
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# ─────────────────────────────────────────────────────────────────────
# EMBEDDINGS (local, no API key needed)
# ─────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─────────────────────────────────────────────────────────────────────
# RAG Chunking
# ─────────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5

# ─────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────
# OLLAMA (Local LLM — CR-01: fully offline primary provider)
# Verify Ollama is running and reachable: `ollama --version` and `ollama list`
# ─────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────
# DATABASE (SQLite by default — zero external services, stays offline)
# ─────────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:////absolute/path/to/app.db   # defaults to <project_root>/app.db

# ─────────────────────────────────────────────────────────────────────
# AUTH / JWT
# IMPORTANT: generate a real random secret before exposing this on a LAN,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
# ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────────────────────────────
# DEFAULT ADMIN (first-run bootstrap only — created if the users table is
# empty at startup). Change this password immediately after first login.
# ─────────────────────────────────────────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
